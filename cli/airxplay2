#!/usr/bin/env sh
# airxplay2 - CLI for the AirPlay 2 receiver panel
set -eu

AXP_URL="${AXP_URL:-http://127.0.0.1:8090}"
HAS_JQ=0
command -v jq >/dev/null 2>&1 && HAS_JQ=1

die() { printf '%s\n' "error: $*" >&2; exit 1; }

_get() {
  curl -fsS --max-time 20 "$AXP_URL$1" || die "cannot reach $AXP_URL (is the container running?)"
}

_post() {
  curl -sS --max-time 90 -X POST "$AXP_URL$1" \
    -H 'Content-Type: application/json' -d "$2" || true
  echo
}

confirm_and_force() {
  # retry a config POST with force=1 when the service must restart mid-playback
  printf '%s' "$1" | grep -q 'needs_confirm' || { printf '%s\n' "$1"; return 0; }
  echo "Playback is active; applying restarts the service (playback/group stops)." >&2
  printf 'Continue? [y/N] ' >&2
  read -r ans
  case "$ans" in y|Y) ;; *) echo "cancelled" >&2; return 1 ;; esac
  local body
  body=$(printf '%s' "$2" | sed 's/}$/,"force":true}/')
  curl -sS -X POST "$AXP_URL$1" -H 'Content-Type: application/json' -d "$body"
  echo
}

usage() {
  cat <<'EOF'
airxplay2 - control the AirPlay 2 receiver

  status                  service, session and volume overview
  devices                 list playback outputs (✓ = connected display)
  test [DEVICE]           play a 2s test tone on one output
  test-all                test every output sequentially
  name "NAME"             set the AirPlay server name
  device DEVICE           select output, e.g. plughw:CARD=PCH,DEV=3
  volume N                set volume 0-100
  delay MS                sync delay in ms (negative = earlier output)
  play|pause|playpause|next|previous
  restart|stop|start
  logs [N]                tail the shairport log (default 40 lines)

Environment: AXP_URL (default http://127.0.0.1:8090)
EOF
}

cmd=${1:-status}
[ $# -gt 0 ] && shift || true

case "$cmd" in
  status)
    if [ "$HAS_JQ" = 1 ]; then
      _get /api/state | jq -r '
        "service   : " + (if .server.running then "running (pid \(.server.pid // "-"))" else "stopped" end) +
        "\nvolume    : \(.volume.app)%  (mode: \(.server.volume_mode))" +
        "\ndevice    : \(.config.device)" +
        "\ndisplay   : " + ((.displays // []) | join(", ") | if . == "" then "none detected" else . end) +
        "\nstate     : \(.now_playing.state)" +
        "\ntrack     : " + ((.now_playing.title // "") | if . == "" then "-" else . end) +
        ((.now_playing.artist // "") | if . == "" then "" else " — " + . end) +
        "\ndelay     : \(.config.latency_offset_ms) ms"'
    else
      _get /api/state; echo
    fi
    ;;
  devices)
    if [ "$HAS_JQ" = 1 ]; then
      _get /api/state | jq -r '.devices[] |
        ((if .connected then "✓ " else "  " end) + .label + "  [" + .value + "]" +
         (if .display then "  -> " + .display else "" end))'
    else
      _get /api/state; echo
    fi
    ;;
  test)
    dev="${1:-}"
    if [ -z "$dev" ]; then
      dev=$(_get /api/state | jq -r '.config.device' 2>/dev/null || true)
    fi
    [ -n "$dev" ] || die "no device given and none selected"
    _post /api/action "{\"action\":\"test-device\",\"device\":\"$dev\"}"
    echo
    ;;
  test-all)
    _post /api/action '{"action":"test-all"}'; echo
    echo "running; check the panel for results"
    ;;
  name)
    [ $# -ge 1 ] || die "usage: airxplay2 name \"My Speaker\""
    body="{\"name\":\"$1\"}"
    confirm_and_force /api/config "$body"
    ;;
  device)
    [ $# -ge 1 ] || die "usage: airxplay2 device plughw:CARD=PCH,DEV=3"
    body="{\"device\":\"$1\"}"
    confirm_and_force /api/config "$body"
    ;;
  volume)
    [ $# -ge 1 ] || die "usage: airxplay2 volume 0-100"
    _post /api/volume "{\"volume\":$1}"; echo
    ;;
  delay)
    [ $# -ge 1 ] || die "usage: airxplay2 delay -150"
    body="{\"latency_offset_ms\":$1}"
    confirm_and_force /api/config "$body"
    ;;
  play|pause|playpause|next|previous|restart|stop|start)
    _post /api/action "{\"action\":\"$cmd\"}" >/dev/null
    echo "$cmd: sent"
    ;;
  logs)
    n=${1:-40}
    if [ "$HAS_JQ" = 1 ]; then
      _get /api/logs | jq -r '.log' | tail -n "$n"
    else
      _get /api/logs | tail -n "$n"
    fi
    ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
